# OpenAI-compatible LLM (server-side; not bundled into the SPA)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Optional parameters
